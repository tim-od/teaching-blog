---
<nav>
  <a href="/" class="brand">Second Chalk</a>
  <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <div class="navlinks">
    <a href="/tags/routes-in">Routes into Teaching</a>
    <a href="/tags/my-journey">My Journey</a>
    <a href="/tags/should-you-move">Should You Move?</a>
    <a href="/tags/practical-advice">Practical Advice</a>
    <a href="/tags/classroom-life">Classroom Life</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 48px;
    background: var(--ink);
    color: var(--paper);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    position: relative;
  }
  .brand {
    font-family: 'Fraunces', serif;
    font-size: 20px;
    font-weight: 600;
    color: var(--marker-soft);
  }
  .navlinks { display: flex; gap: 28px; align-items: center; }
  .navlinks a { opacity: 0.85; }
  .navlinks a:hover { opacity: 1; color: var(--marker-soft); }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .menu-toggle span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--marker-soft);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle.open span:nth-child(2) { opacity: 0; }
  .menu-toggle.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 860px) {
    nav { padding: 18px 22px; }
    .menu-toggle { display: flex; }
    .navlinks {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--ink);
      border-top: 1px solid rgba(255,255,255,0.12);
    }
    .navlinks.open { display: flex; }
    .navlinks a {
      width: 100%;
      padding: 16px 22px;
      box-sizing: border-box;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const links = document.querySelector('.navlinks');
  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('open');
    toggle.classList.toggle('open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
