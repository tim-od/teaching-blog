---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allTags = ['Routes In', 'My Journey', 'Should You Move?', 'Practical Advice', 'Classroom Life'];

function slugify(tag) {
  return tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const allTags = ['Routes In', 'My Journey', 'Should You Move?', 'Practical Advice', 'Classroom Life'];

  function slugify(tag) {
    return tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  }

  return allTags.map(tag => {
    const slug = slugify(tag);
    const posts = allPosts
      .filter(post => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return { params: { tag: slug }, props: { tagName: tag, posts } };
  });
}

const { tagName, posts } = Astro.props;
---
<BaseLayout title={tagName} description={`Posts about ${tagName} on Second Bell.`}>
  <section class="tag-hero">
    <span class="eyebrow">Category</span>
    <h1>{tagName}</h1>
  </section>

  <div class="grid">
    {posts.length === 0 && (
      <p class="empty">No posts here yet — check back soon.</p>
    )}
    {posts.map(post => (
      <a href={`/posts/${post.id}/`} class="card">
        {post.data.heroImage && (
          <Image src={post.data.heroImage} alt={post.data.heroImageAlt || ''} width={400} height={220} class="card-img" />
        )}
        <div class="card-body">
          <span class="card-tag">{post.data.tags[0]}</span>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <span class="card-date">{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .tag-hero { background: var(--ink); color: var(--paper); padding: 64px 48px; }
  .eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--marker-soft); margin-bottom: 14px; display: block; }
  .tag-hero h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 40px; margin: 0; }

  .grid { max-width: 1120px; margin: 0 auto; padding: 50px 48px 100px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 34px; }
  .empty { grid-column: 1 / -1; font-size: 15px; color: var(--ink-soft); text-align: center; padding: 40px 0; }
  .card { background: var(--paper-deep); border-radius: 4px; overflow: hidden; border: 1px solid var(--line); display: block; }
  .card-img { width: 100%; height: 160px; object-fit: cover; display: block; }
  .card-body { padding: 20px 22px 26px; }
  .card-tag { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--brick); margin-bottom: 10px; display: block; }
  .card h3 { font-family: 'Fraunces', serif; font-size: 21px; font-weight: 600; line-height: 1.25; margin: 0 0 10px; color: var(--ink); }
  .card p { font-size: 14.5px; line-height: 1.55; color: var(--ink-soft); margin: 0 0 14px; }
  .card-date { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--date-text); }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; padding-left: 24px; padding-right: 24px; }
    .tag-hero { padding: 48px 24px; }
  }
</style>
