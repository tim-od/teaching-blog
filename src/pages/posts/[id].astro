---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";

function slugify(tag) {
  return tag
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
}

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    {
      post.data.heroImage && (
        <Image
          src={post.data.heroImage}
          alt={post.data.heroImageAlt || ""}
          layout="full-width"
          class="hero-image"
        />
      )
    }
    <div class="post-wrap">
      <div class="tags">
        {
          post.data.tags.map((tag) => (
            <a href={`/tags/${slugify(tag)}`} class="tag">
              {tag}
            </a>
          ))
        }
      </div>
      <h1>{post.data.title}</h1>
      <time
        >{
          post.data.pubDate.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })
        }</time
      >
      <div class="content">
        <TableOfContents headings={headings} />
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 650px;
    object-fit: contain;
    background: var(--paper-deep);
  }
  .post-wrap {
    max-width: 700px;
    margin: 0 auto;
    padding: 50px 24px 100px;
  }
  .tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .tag {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 5px 11px;
    border: 1.5px dashed var(--brick);
    color: var(--brick);
    border-radius: 3px;
  }
  .tag:hover {
    background: var(--brick);
    color: var(--paper);
  }
  h1 {
    font-family: "Fraunces", serif;
    font-size: 40px;
    line-height: 1.15;
    margin: 0 0 12px;
    color: var(--ink);
  }
  time {
    font-family: "IBM Plex Mono", monospace;
    font-size: 12.5px;
    color: var(--date-text);
    display: block;
    margin-bottom: 40px;
  }
  .content {
    font-size: 17px;
    line-height: 1.75;
    color: var(--ink);
  }
  .content :global(p) {
    margin: 0 0 22px;
  }
  .content :global(h2) {
    font-family: "Fraunces", serif;
    font-size: 26px;
    margin: 40px 0 16px;
  }
  .content :global(a) {
    color: var(--brick);
    text-decoration: underline;
  }
  .content :global(img) {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    margin: 32px auto;
    border-radius: 4px;
  }
  .content :global(blockquote) {
    font-family: "Fraunces", serif;
    font-size: 21px;
    font-style: italic;
    border-left: 3px solid var(--marker);
    margin: 30px 0;
    padding: 4px 0 4px 24px;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    h1 {
      font-size: 30px;
    }
    .hero-image {
      max-height: none;
    }
  }
  .content :global(h2),
  .content :global(h3) {
    scroll-margin-top: 100px;
  }
  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
