---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    {post.data.heroImage && (
      <Image
        src={post.data.heroImage}
        alt={post.data.heroImageAlt || ''}
        width={1200}
        height={500}
        class="hero-image"
      />
    )}
    <div class="post-wrap">
      <div class="tags">
        {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      <time>{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time>
      <div class="content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .hero-image { width: 100%; height: 420px; object-fit: cover; display: block; }
  .post-wrap { max-width: 700px; margin: 0 auto; padding: 50px 24px 100px; }
  .tags { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
  .tag { font-family: 'IBM Plex Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; padding: 5px 11px; border: 1.5px dashed var(--brick); color: var(--brick); border-radius: 3px; }
  h1 { font-family: 'Fraunces', serif; font-size: 40px; line-height: 1.15; margin: 0 0 12px; color: var(--ink); }
  time { font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; color: #8A8267; display: block; margin-bottom: 40px; }
  .content { font-size: 17px; line-height: 1.75; color: var(--ink); }
  .content :global(p) { margin: 0 0 22px; }
  .content :global(h2) { font-family: 'Fraunces', serif; font-size: 26px; margin: 40px 0 16px; }
  .content :global(a) { color: var(--brick); text-decoration: underline; }
  .content :global(blockquote) {
    font-family: 'Fraunces', serif;
    font-size: 21px;
    font-style: italic;
    border-left: 3px solid var(--marker);
    margin: 30px 0;
    padding: 4px 0 4px 24px;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    h1 { font-size: 30px; }
    .hero-image { height: 260px; }
  }
</style>
